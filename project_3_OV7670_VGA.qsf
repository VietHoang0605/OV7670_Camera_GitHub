set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C20F484C7
set_global_assignment -name TOP_LEVEL_ENTITY ov7670_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 13.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "15:00:00 SEPTEMBER 19, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1

# ==========================================================
# 1. ADD SOURCE VERILOG FILES
# ==========================================================
set_global_assignment -name VERILOG_FILE ov7670_top.v
set_global_assignment -name VERILOG_FILE ov7670_config.v
set_global_assignment -name VERILOG_FILE ov7670_capture.v
set_global_assignment -name VERILOG_FILE i2c_master.v
set_global_assignment -name VERILOG_FILE i2c_clk_gen.v
set_global_assignment -name VERILOG_FILE sdram_arbiter.v
set_global_assignment -name VERILOG_FILE sdram_controller.v
set_global_assignment -name VERILOG_FILE async_fifo.v
set_global_assignment -name VERILOG_FILE fifo_sync.v
set_global_assignment -name VERILOG_FILE dual_port_ram.v
set_global_assignment -name VERILOG_FILE rptr_empty.v
set_global_assignment -name VERILOG_FILE sync_r2w.v
set_global_assignment -name VERILOG_FILE sync_w2r.v
set_global_assignment -name VERILOG_FILE wptr_full.v
set_global_assignment -name VERILOG_FILE vga_sync.v

# ==========================================================
# 2. CLOCK AND RESET PINS (DE1 STANDARD)
# ==========================================================
set_location_assignment PIN_L1 -to clk_50m
set_location_assignment PIN_L22 -to rst_n

# ==========================================================
# 3. CAMERA OV7670 PINS (MAPPED TO GPIO_0 / JP1)
# ==========================================================
# Tín hiệu Data (D7 -> D0)
set_location_assignment PIN_A13 -to cam_data[7]
set_location_assignment PIN_B13 -to cam_data[6]
set_location_assignment PIN_A14 -to cam_data[5]
set_location_assignment PIN_B14 -to cam_data[4]
set_location_assignment PIN_A15 -to cam_data[3]
set_location_assignment PIN_B15 -to cam_data[2]
set_location_assignment PIN_A16 -to cam_data[1]
set_location_assignment PIN_B16 -to cam_data[0]

# Giao tiếp I2C / SCCB
set_location_assignment PIN_A17 -to cam_scl
set_location_assignment PIN_B17 -to cam_sda

# Tín hiệu đồng bộ DVP
set_location_assignment PIN_A18 -to cam_vsync
set_location_assignment PIN_B18 -to cam_href
set_location_assignment PIN_A19 -to cam_pclk

# Clock phụ & Tín hiệu điều khiển
set_location_assignment PIN_B19 -to cam_xclk
set_location_assignment PIN_A20 -to cam_reset
set_location_assignment PIN_B20 -to cam_pwdn

# ==========================================================
# 4. VGA PINS (DE1 ON-BOARD DAC)
# ==========================================================
set_location_assignment PIN_D9 -to vga_r[0]
set_location_assignment PIN_C9 -to vga_r[1]
set_location_assignment PIN_A7 -to vga_r[2]
set_location_assignment PIN_B7 -to vga_r[3]

set_location_assignment PIN_B8 -to vga_g[0]
set_location_assignment PIN_C10 -to vga_g[1]
set_location_assignment PIN_B9 -to vga_g[2]
set_location_assignment PIN_A8 -to vga_g[3]

set_location_assignment PIN_A9 -to vga_b[0]
set_location_assignment PIN_D11 -to vga_b[1]
set_location_assignment PIN_A10 -to vga_b[2]
set_location_assignment PIN_B10 -to vga_b[3]

set_location_assignment PIN_A11 -to vga_hsync
set_location_assignment PIN_B11 -to vga_vsync

# ==========================================================
# 5. SDRAM PINS (DE1 ON-BOARD IS42S16400)
# ==========================================================
set_location_assignment PIN_W4 -to sdram_addr[0]
set_location_assignment PIN_W5 -to sdram_addr[1]
set_location_assignment PIN_Y3 -to sdram_addr[2]
set_location_assignment PIN_Y4 -to sdram_addr[3]
set_location_assignment PIN_R6 -to sdram_addr[4]
set_location_assignment PIN_R5 -to sdram_addr[5]
set_location_assignment PIN_P6 -to sdram_addr[6]
set_location_assignment PIN_P5 -to sdram_addr[7]
set_location_assignment PIN_P3 -to sdram_addr[8]
set_location_assignment PIN_N4 -to sdram_addr[9]
set_location_assignment PIN_W3 -to sdram_addr[10]
set_location_assignment PIN_N6 -to sdram_addr[11]

set_location_assignment PIN_U1 -to sdram_dq[0]
set_location_assignment PIN_U2 -to sdram_dq[1]
set_location_assignment PIN_V1 -to sdram_dq[2]
set_location_assignment PIN_V2 -to sdram_dq[3]
set_location_assignment PIN_W1 -to sdram_dq[4]
set_location_assignment PIN_W2 -to sdram_dq[5]
set_location_assignment PIN_Y1 -to sdram_dq[6]
set_location_assignment PIN_Y2 -to sdram_dq[7]
set_location_assignment PIN_N1 -to sdram_dq[8]
set_location_assignment PIN_N2 -to sdram_dq[9]
set_location_assignment PIN_P1 -to sdram_dq[10]
set_location_assignment PIN_P2 -to sdram_dq[11]
set_location_assignment PIN_R1 -to sdram_dq[12]
set_location_assignment PIN_R2 -to sdram_dq[13]
set_location_assignment PIN_T1 -to sdram_dq[14]
set_location_assignment PIN_T2 -to sdram_dq[15]

set_location_assignment PIN_U3 -to sdram_ba[0]
set_location_assignment PIN_V4 -to sdram_ba[1]
set_location_assignment PIN_T3 -to sdram_cas_n
set_location_assignment PIN_N3 -to sdram_cke
set_location_assignment PIN_U4 -to sdram_clk
set_location_assignment PIN_T6 -to sdram_cs_n
set_location_assignment PIN_R7 -to sdram_ldqm
set_location_assignment PIN_T5 -to sdram_ras_n
set_location_assignment PIN_M5 -to sdram_udqm
set_location_assignment PIN_R8 -to sdram_we_n

# ==========================================================
# 6. QUARTUS OPTIMIZATION & FITTING RULES
# ==========================================================
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_ASDO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DATA0_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DATA1_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_FLASH_NCE_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DCLK_AFTER_CONFIGURATION "USE AS REGULAR IO"

set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_location_assignment PIN_R20 -to LED[0]
set_location_assignment PIN_R19 -to LED[1]
set_location_assignment PIN_U19 -to LED[2]
set_location_assignment PIN_Y19 -to LED[3]
set_location_assignment PIN_T18 -to LED[4]
set_location_assignment PIN_V19 -to LED[5]
set_location_assignment PIN_Y18 -to LED[6]
set_location_assignment PIN_U18 -to LED[7]
set_location_assignment PIN_R18 -to LED[8]
set_location_assignment PIN_R17 -to LED[9]

set_global_assignment -name ENABLE_SIGNALTAP ON
set_global_assignment -name USE_SIGNALTAP_FILE output_files/stp1.stp
set_global_assignment -name SIGNALTAP_FILE output_files/stp1.stp
set_global_assignment -name SLD_NODE_CREATOR_ID 110 -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_ENTITY_NAME sld_signaltap -section_id auto_signaltap_0
set_instance_assignment -name POST_FIT_CONNECT_TO_SLD_NODE_ENTITY_PORT acq_clk -to clk_50m -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_trigger_in[0] -to cam_scl -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_trigger_in[1] -to cam_sda -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_data_in[0] -to cam_scl -section_id auto_signaltap_0
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_data_in[1] -to cam_sda -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_DATA_BITS=2" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_TRIGGER_BITS=2" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_NODE_INFO=805334528" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_POWER_UP_TRIGGER=0" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_SEGMENT_SIZE=8192" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_ATTRIBUTE_MEM_MODE=OFF" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_NODE_CRC_LOWORD=21052" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_TRIGGER_LEVEL=1" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_SAMPLE_DEPTH=8192" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_TRIGGER_IN_ENABLED=0" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_ADVANCED_TRIGGER_ENTITY=basic,1," -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_TRIGGER_LEVEL_PIPELINE=1" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_ENABLE_ADVANCED_TRIGGER=0" -section_id auto_signaltap_0

set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_INVERSION_MASK=000000000000000000000000000000000" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_INVERSION_MASK_LENGTH=33" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_STORAGE_QUALIFIER_INVERSION_MASK_LENGTH=0" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_STATE_FLOW_USE_GENERATED=0" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_STATE_BITS=11" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_BUFFER_FULL_STOP=1" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_CURRENT_RESOURCE_WIDTH=1" -section_id auto_signaltap_0
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_NODE_CRC_HIWORD=51781" -section_id auto_signaltap_0

set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to cam_sda

set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to cam_scl

# ==============================================================================
# [FIX PROJECT 2] KHU GROUND BOUNCE & NHIEU BURST SDRAM CHO DAC VGA
# ==============================================================================
set_instance_assignment -name SLOW_SLEW_RATE ON -to sdram_addr[*]
set_instance_assignment -name SLOW_SLEW_RATE ON -to sdram_ba[*]
set_instance_assignment -name SLOW_SLEW_RATE ON -to sdram_cas_n
set_instance_assignment -name SLOW_SLEW_RATE ON -to sdram_cke
set_instance_assignment -name SLOW_SLEW_RATE ON -to sdram_clk
set_instance_assignment -name SLOW_SLEW_RATE ON -to sdram_cs_n
set_instance_assignment -name SLOW_SLEW_RATE ON -to sdram_dq[*]
set_instance_assignment -name SLOW_SLEW_RATE ON -to sdram_ldqm
set_instance_assignment -name SLOW_SLEW_RATE ON -to sdram_ras_n
set_instance_assignment -name SLOW_SLEW_RATE ON -to sdram_udqm
set_instance_assignment -name SLOW_SLEW_RATE ON -to sdram_we_n

set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to sdram_addr[*]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to sdram_ba[*]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to sdram_cas_n
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to sdram_cke
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to sdram_clk
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to sdram_cs_n
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to sdram_dq[*]
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to sdram_ldqm
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to sdram_ras_n
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to sdram_udqm
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to sdram_we_n













set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name SLD_FILE "D:/FPGA/Projects/project_3_OV7670_VGA/output_files/stp1_auto_stripped.stp"